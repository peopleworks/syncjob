<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A doc comment is for what is not obvious. Requiring one on every public
         member buys filler on StartedAt and teaches contributors to write it. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>1.0.0</Version>
    <Description>The data-movement engine behind SyncJob: streaming copy, staging with a row guard, publication by swap, merge and watermark. Packaged so that CLIs, services and applications share one implementation instead of forking it.</Description>
    <Authors>Pedro Hernández (PeopleWorks)</Authors>
    <Company>PeopleWorks</Company>
    <Copyright>© 2026 PeopleWorks</Copyright>
    <RepositoryUrl>https://github.com/peopleworks/SyncJob</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>PeopleWorks.SyncJob.Core</PackageId>
    <PackageTags>sql-server;etl;data-sync;bulk-copy;library</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <!-- The staging table is created from the destination's own catalog entry, and the
         reader and the CREATE TABLE renderer that do it are SQLDiff's engine. Referenced
         rather than copied: a second copy of a schema reader is a second copy of every
         type-rendering bug it has already had fixed. -->
    <PackageReference Include="PeopleWorks.SqlSchemaDiff.Core" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
